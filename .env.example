# Copy to .env and edit (never commit .env — it is gitignored).
#   cp .env.example .env
#
# Existing shell exports override values here.

# Required: shared unlock PIN for household phones.
MINER_PIN=change-me

# Optional listen address (default :8080 = all interfaces).
# For make run-tunnel default, the tunnel script uses 127.0.0.1:8080 unless set.
# MINER_ADDR=:8080

# Optional durable queue directory (default data/).
# MINER_DATA_DIR=data

# Optional: load templates/static from disk instead of embed (dev).
# MINER_WEB_ROOT=

# Optional OCR paths (make run / make ocr-install default to .deps/).
# MINER_NDL_ROOT=
# MINER_NDL_PYTHON=
# MINER_NDL_WORKER=
# MINER_NDL_DEVICE=cpu
